Package: mortar
Type: Package
Title: Standardize Data Science Workflows
Version: 0.4.0
Authors@R: 
    c(
    person("Joseph","Zemmels",email="jzemmels@usgs.gov",role = c("aut"),comment = c(ORCID = "0009-0008-1463-6313")),
