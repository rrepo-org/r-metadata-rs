Package: MLCIRTwithin
Type: Package
Title: Latent Class Item Response Theory (LC-IRT) Models under
        Within-Item Multidimensionality
Version: 2.1.2
Date: 2025-06-27
Authors@R: c(person(given = "Francesco",
                      family = "Bartolucci",
                      role = c("aut", "cre"),
                      email = "francesco.bartolucci@unipg.it"),
               person(given = "Silvia",
