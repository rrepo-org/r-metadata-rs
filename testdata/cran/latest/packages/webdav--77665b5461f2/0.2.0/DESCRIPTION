Package: webdav
Type: Package
Title: A Simple Interface for Interacting with 'WebDAV' Servers
Version: 0.2.0
Date: 2026-04-07
Authors@R: c(
    person("Andre", "Leite", email = "leite@castlab.org", role = c("aut", "cre")),
    person("Marcos", "Wasilew", email = "marcos.wasilew@gmail.com", role = "aut"),
