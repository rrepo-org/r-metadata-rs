Package: rankingQ
Type: Package
Title: Design-Based Methods for Ranking Questions
Version: 0.2.0
Authors@R: c(
  person("Seo-young Silvia", "Kim", email = "sy.silvia.kim@gmail.com",
  role = c("aut", "cre", "cph"), comment = c(ORCID="0000-0002-8801-9210")),
