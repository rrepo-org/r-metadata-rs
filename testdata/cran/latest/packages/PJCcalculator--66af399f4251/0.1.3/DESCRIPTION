Package: PJCcalculator
Title: PROs-Joint Contrast (PJC) Calculator
Version: 0.1.3
Authors@R: c(
    person(given = "Ning",      family = "Meng",   email = "nmeng2@jh.edu", role = c("aut", "cre")),
    person(given = "Ji Soo",    family = "Kim",                                role = "aut"),
