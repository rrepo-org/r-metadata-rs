Package: NeighborFinder
Title: Find Neighbor Species of a Bacteria of Interest in the Human Gut
        Microbiota
Version: 1.0.1
Authors@R: c(
    person("Mathilde", "Sola", , "mathilde.sola@inrae.fr", role = c("aut", "cre"),
