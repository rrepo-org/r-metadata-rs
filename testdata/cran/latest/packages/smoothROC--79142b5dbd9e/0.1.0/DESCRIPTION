Type: Package
Package: smoothROC
Title: Kernel-Smoothed ROC and AUC with Bandwidth Selection
Version: 0.1.0
Authors@R: c(
    person("Ruhul Ali", "Khan", , "ruhulali.khan@gmail.com", role = c("aut", "cre"),
