Package: PRBMSdesigns
Title: Partially Residual Balanced Multi-Session Designs
Version: 1.0.1
Authors@R: c(
    person("Boyina Devi", "Priyanka",
           email = "boyinadevipriyanka@gmail.com",
           role = c("aut", "cre")),
    person("Cini", "Varghese", role = "ctb"),
