Package: MAARTS
Type: Package
Title: Merger and Acquisition Autoregressive Time-Series Models
Version: 1.0.0
Authors@R: c(
    person("Shikhar", "Tyagi",
        email = "shikhar1093tyagi@gmail.com",
        role = c("aut", "cre"),
        comment = c(ORCID = "0000-0003-1606-0844")),
