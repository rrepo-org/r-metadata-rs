Package: MVNGmod
Type: Package
Title: Matrix-Variate Non-Gaussian Linear Regression Models
Version: 0.1.2
Authors@R: 
    c(person("Samuel", "Soon", , "samksoon2@gmail.com", role = c("aut", "cre"),
