Package: reliaR
Type: Package
Title: Comprehensive Tools for some Probability Distributions
Version: 0.2
Authors@R: c(person(given = "Vijay",
                       family = "Kumar",
                       role = c("aut", "cre"),
                       email = "vkgkp@rediffmail.com"),
                person(given = "Uwe",
                       family = "Ligges",
