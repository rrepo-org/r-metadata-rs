Package: STCCGEV
Title: Conditional Copula Model for Crop Yield Forecasting
Version: 1.0.0
Authors@R: 
    c(
    person("Marie", "Michaelides", email= "marie.michaelides@concordia.ca", role = c("aut")),
    person("Mélina", "Mailhot", email= "melina.mailhot@concordia.ca", role = c("aut")),
    person("Yongkun", "Li", email= "yongkun.li@concordia.ca", role = c("aut", "cre"))
