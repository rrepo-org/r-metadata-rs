Package: liteformats
Title: Lightweight Output Formats for 'litedown'
Version: 0.2.0
Authors@R: c(
    person("Nan", "Xiao", email = "me@nanx.me", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-0250-5673")),
