Package: ShiftHappens
Type: Package
Title: Detecting, Visualizing and Estimating Shifts
Version: 1.0.1
Authors@R: c(
    person("Felipe", "Mendez", email = "felipe-alberto.mendez-rios@inrae.fr",role = c("aut"),comment = c(ORCID = "0009-0004-0371-8699")),
