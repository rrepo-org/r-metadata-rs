Package: ksamplesLTRC
Title: K-Sample Tests for Truncated and/or Censored Data
Version: 0.1.0
Authors@R: c(
    person(given = "Adrián", family = "Lago", email = "adrian.lago@uvigo.gal", role = c("aut", "cre")),
    person(given = "Jacobo", family = "de Uña-Álvarez", email = "jacobo@uvigo.gal", role = "aut"),
    person(given = "Juan Carlos", family = "Pardo-Fernández", email = "juancp@uvigo.gal", role = "aut")
