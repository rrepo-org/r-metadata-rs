Package: predHCS
Type: Package
Title: Point and Interval Prediction for Censored Data under Various
        Hybrid Censoring Schemes
Version: 0.1.0
Authors@R: c(
    person("Shikhar", "Tyagi", email = "shikhar1093tyagi@gmail.com", role = c("aut", "cre"), comment = c(ORCID = "0000-0003-1606-0844")),
