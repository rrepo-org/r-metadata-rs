Package: vimixr
Title: Collapsed Variational Inference for Dirichlet Process (DP)
        Mixture Model
Version: 0.1.2
Authors@R: c( 
    person("Annesh", "Pal", , "sistm.soft.maintain@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0003-2146-180X")),
