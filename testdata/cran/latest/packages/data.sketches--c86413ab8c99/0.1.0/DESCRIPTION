Package: data.sketches
Title: Probabilistic Streaming Data Sketches
Version: 0.1.0
Authors@R: c(
    person("Pedro", "Baltazar", email = "pedrobtz@gmail.com",
           role = c("aut", "cre", "cph")),
    person("The Apache Software Foundation", role = "ctb",
