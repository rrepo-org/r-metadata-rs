Package: GowerSom
Type: Package
Title: Self-Organizing Maps for Mixed-Attribute Data Using Gower
        Distance
Version: 0.1.0
Authors@R: c(
    person("Patricio", "Salas",
           role = c("aut", "cre"),
           email = "patricioasalas@udec.cl",
