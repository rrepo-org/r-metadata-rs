Package: OnAge
Title: Test of Between-Group Differences in the Onset of Senescence
Version: 1.0.2
Authors@R: c(
   person("Laurent", "Jacob", role = "aut"),
   person("Frédéric", "Douhard", role = "aut", comment = c(ORCID = "0000-0002-8503-1089")),
