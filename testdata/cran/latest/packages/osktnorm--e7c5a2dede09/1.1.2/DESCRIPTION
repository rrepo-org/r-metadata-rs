Package: osktnorm
Type: Package
Title: A Moment-Targeting Normality Transformation Based on Tukey g-h
        Distribution
Version: 1.1.2
Date: 2026-03-07
Authors@R: 
    c(person("Zeynel", "Cebeci", email = "cebeciz@gmail.com", role = c("aut", "cre")),
      person("Figen", "Ceritoglu", role = "aut"),
      person("Melis", "Celik Guney", role = "aut"),
