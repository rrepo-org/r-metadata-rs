Package: eFCM
Type: Package
Title: Exponential Factor Copula Model
Version: 1.0
Authors@R: 
    c(
      person("Mengran", "Li", email = "m.li.3@research.gla.ac.uk", role = c("aut", "cre")),
      person("Daniela", "Castro-Camilo", role = "aut")
