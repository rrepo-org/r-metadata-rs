Package: pvclass
Type: Package
Title: P-Values for Classification
Version: 1.4.1
Date: 2025-04-30
Authors@R: c(person(given = "Niki",
                      family = "Zumbrunnen",
                      role = c("aut", "cre"),
                      email = "niki.zumbrunnen@gmail.com"),
               person(given = "Lutz",
                      family = "Duembgen.",
                      role = "aut",
