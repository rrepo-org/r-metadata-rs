Package: adklakedata
Title: Adirondack Long-Term Lake Data
Version: 0.7.1
Maintainer: Jeremy Farrell <jeremyfarrell@gmail.com>
Authors@R: c(
    person("Jeremy", "Farrell", , "jeremyfarrell@gmail.com", role = c("aut", "cre")),
    person("Luke", "Winslow", role = "aut"),
    person("Taylor", "Leach", role = "aut"),
    person("Tobi", "Hahn", role = "aut")
