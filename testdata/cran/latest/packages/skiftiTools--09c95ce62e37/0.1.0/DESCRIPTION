Package: skiftiTools
Title: Tools and Operations for Reading, Writing, Viewing, and
        Manipulating SKIFTI Files
Version: 0.1.0
Authors@R: 
    c(person("Harri", "Merisaari", "", email = "harri.merisaaari@utu.fi", role = "aut",
