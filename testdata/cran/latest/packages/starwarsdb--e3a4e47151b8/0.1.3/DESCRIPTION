Package: starwarsdb
Title: Relational Data from the 'Star Wars' API for Learning and
        Teaching
Version: 0.1.3
Authors@R: 
    person("Garrick", "Aden-Buie", , "garrick@adenbuie.com", role = c("aut", "cre"),
