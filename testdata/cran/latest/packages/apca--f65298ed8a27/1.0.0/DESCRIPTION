Package: apca
Type: Package
Title: Advanced Principal Component Analysis
Version: 1.0.0
Date: 2026-04-19
Authors@R: c(
    person(given = "Angga Dwi", family = "Mulyanto", role = c("aut", "cre"), email = "angga.dwi.m@gmail.com", comment = "Institut Teknologi Sepuluh Nopember, Universitas Islam Negeri Maulana Malik Ibrahim Malang"),
