Package: CICI
Type: Package
Title: Causal Inference with Continuous (Multiple Time Point)
        Interventions
Version: 1.0
Date: 2026-04-06
Authors@R: c(person("Michael", "Schomaker", email = "michael.schomaker@stat.uni-muenchen.de", role = c("aut", "cre")),
