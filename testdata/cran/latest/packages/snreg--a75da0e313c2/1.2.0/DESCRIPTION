Package: snreg
Type: Package
Title: Regression with Skew-Normally Distributed Error Term
Version: 1.2.0
Date: 2026-01-31
Authors@R: c(
    person("Oleg", "Badunenko", email = "Oleg.Badunenko@brunel.ac.uk", role = c("aut", "cre"),
