Package: testflow
Title: A Workflow for Statistical Testing and Interpretation
Version: 1.0.0
Authors@R: c(
    person(
      given = "Imad",
      family = "El Badisy",
      role = c("aut", "cre"),
      email = "elbadisyimad@gmail.com"
