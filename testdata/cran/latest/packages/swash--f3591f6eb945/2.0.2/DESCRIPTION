Package: swash
Type: Package
Title: Health Geography Toolbox for Model-Based Analysis of Infections
        Panel Data
Version: 2.0.2
Date: 2026-08-30
Authors@R: person("Thomas", "Wieland", role = c("aut", "cre"),
