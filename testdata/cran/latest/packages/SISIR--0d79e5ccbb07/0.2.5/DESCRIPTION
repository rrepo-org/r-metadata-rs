Package: SISIR
Type: Package
Title: Select Intervals Suited for Functional Regression
Version: 0.2.5
Date: 2026-07-07
Authors@R: c(
  person("Victor", "Picheny", , "victor.picheny@inrae.fr", c("aut"), 
    comment = c(ORCID = "0000-0002-4948-5542")),
