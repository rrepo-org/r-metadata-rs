Package: RMeDPower2
Type: Package
Title: Design and Modeling for Repeated Measures Studies
Version: 1.0.2
Authors@R: c(
    person("Min-Gyoung", "Shin",
           email = "mingyoung.shin@gladstone.ucsf.edu",
           role = c("aut")),
    person("Reuben", "Thomas",
           email = "reuben.thomas@gladstone.ucsf.edu",
