Package: voigt
Type: Package
Title: The Voigt Distribution
Version: 2.0
Date: 2025-08-18
Authors@R: c(person("Massimo", "Cannas", role = c("aut", "cre"),
                     email = "massimo.cannas@unica.it"),
              person("Nicola", "Piras", role = c("aut"),
