Package: iPRSue
Title: Individual Polygenic Risk Score Uncertainty Estimation
Version: 1.0.0
Authors@R: 
    c(
      person("Dovini", "Jayasinghe", 
             email = "dovini.jayasinghe@mymail.unisa.edu.au", 
             role = c("aut", "cre", "cph")),
      person("Hong", "Lee", 
