Package: comexr
Title: Client for the Brazilian Foreign Trade Statistics API
        ('ComexStat')
Version: 0.3.0
Date: 2026-05-21
Authors@R: c(
    person("Andre", "Leite", email = "leite@castlab.org", role = c("aut", "cre")),
    person("Marcos", "Wasilew", email = "marcos.wasilew@gmail.com", role = "aut"),
