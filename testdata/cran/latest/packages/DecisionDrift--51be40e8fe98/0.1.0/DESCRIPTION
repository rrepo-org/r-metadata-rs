Package: DecisionDrift
Title: Detecting, Decomposing, and Stress-Testing Temporal Change in
        Repeated Decision Systems
Version: 0.1.0
Authors@R: 
    person(
      given   = "Subir",
      family  = "Hait",
      role    = c("aut", "cre"),
      email   = "haitsubi@msu.edu",
      comment = c(ORCID = "0009-0004-9871-9677")
