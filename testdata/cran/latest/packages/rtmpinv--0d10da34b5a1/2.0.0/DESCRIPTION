Package: rtmpinv
Type: Package
Title: Tabular Matrix Problems via Pseudoinverse Estimation
Version: 2.0.0
Authors@R: 
    c(
        person("Ilya", "Bolotov", email = "ilya.bolotov@vse.cz",
               role = c("aut", "cre"),
               comment = c(ORCID = "0000-0003-1148-7144"))
