Package: ordinalbayes
Title: Bayesian Ordinal Regression for High-Dimensional Data
Version: 0.1.2
Date: 2025-04-30
Authors@R: c(person("Kellie J.", "Archer", email = "archer.43@osu.edu",
  role = c("aut", "cre"), comment = c(ORCID = "0000-0003-1555-5781")),
