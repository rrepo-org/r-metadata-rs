Package: tikatuwq
Type: Package
Title: Water Quality Assessment and Environmental Compliance in Brazil
Version: 0.9.0
Authors@R: 
    c(person(given = "Vinicius",
             family = "Saraiva Santos",
             role = c("aut", "cre"),
