Package: mapycusmaximus
Title: Focus-Glue-Context Fisheye Transformations for Spatial
        Visualization
Version: 1.0.7
Authors@R: c(
    person("Alex", "Nguyen", , "thanhcuong10091992@gmail.com", role = c("aut", "cre", "cph")),
