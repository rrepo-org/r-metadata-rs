Package: crawlee
Title: Tidy Interface for Reproducible Web Crawling
Version: 0.1.0
Authors@R: c(
    person("Andre", "Leite", email = "leite@castlab.org", role = c("aut", "cre")),
    person("Marcos", "Wasilew", email = "marcos.wasilew@gmail.com", role = "aut"),
