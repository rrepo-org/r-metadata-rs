Package: DSFM
Type: Package
Title: Distributed Skew Factor Model Estimation Methods
Version: 1.0.1
Authors@R: 
    c(
      person(given = "Guangbao", family = "Guo", role = c("aut", "cre"), email = "ggb11111111@163.com"),
