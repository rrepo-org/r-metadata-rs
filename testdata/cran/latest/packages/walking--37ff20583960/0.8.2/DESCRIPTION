Package: walking
Title: Segments Accelerometry Data into Walking Bouts using Open Source
        Methods
Version: 0.8.2
Authors@R: 
    person(given = "John",
           family = "Muschelli",
           role = c("aut", "cre"),
           email = "muschellij2@gmail.com",
