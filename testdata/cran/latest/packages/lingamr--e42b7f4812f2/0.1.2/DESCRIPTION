Type: Package
Package: lingamr
Title: 'LiNGAM' Algorithms for Causal Discovery
Version: 0.1.2
Authors@R: c(
    person("Osamu", "Morimoto", , "galactic.supermarket@gmail.com", role = c("aut", "cre", "cph")),
