Package: scindex
Title: Strategic Convergence Index for Inter-Rater Reliability
Version: 0.1.0
Authors@R: 
    person(
      given = "Irene",
      family = "Gianeselli",
      role = c("aut", "cre"),
      email = "irene.gianeselli@unibz.it",
      comment = c(ORCID = "https://orcid.org/0000-0002-8689-3035")
