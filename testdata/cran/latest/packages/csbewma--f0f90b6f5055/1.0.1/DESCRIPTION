Package: csbewma
Title: Cumulative Standardized Binomial EWMA for Multiple Stream
        Processes
Version: 1.0.1
Authors@R: c(
    person("Faruk", "Muritala", email = "fmurital@students.kennesaw.edu", role = c("aut", "cre")),
