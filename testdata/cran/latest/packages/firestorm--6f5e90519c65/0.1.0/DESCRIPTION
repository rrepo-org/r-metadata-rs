Package: firestorm
Title: Reverse Proxy and Load Balancing for 'fiery'
Version: 0.1.0
Authors@R: c(
    person("Thomas Lin", "Pedersen", , "thomas.pedersen@posit.co", role = c("aut", "cre"),
