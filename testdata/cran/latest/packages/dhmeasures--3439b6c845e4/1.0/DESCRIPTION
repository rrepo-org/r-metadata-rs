Package: dhmeasures
Title: Digital History Measures
Version: 1.0
Authors@R: c(
  person("Ryan", "Schaefer", email = "rschaefer1@me.com", role = c("aut"),
	       comment = c(ORCID = "0000-0001-7694-3994")),
