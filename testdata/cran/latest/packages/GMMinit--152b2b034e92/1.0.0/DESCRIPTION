Package: GMMinit
Type: Package
Title: Optimal Initial Value for Gaussian Mixture Model
Date: 2026-01-20
Authors@R: c(person("Jing", "Li", 
             email = "jli178@crimson.ua.edu", role = c("aut", "cre")),
