Package: PDXpower
Type: Package
Title: Time to Event Outcome in Experimental Designs of Pre-Clinical
        Studies
Version: 1.0.5
Date: 2025-12-15
Authors@R: c(
    person("Shanpeng", "Li", email = "lishanpeng0913@ucla.edu", 
