Package: aedl
Type: Package
Title: Almost-Exact Inference for the DerSimonian-Laird Test Statistic
Version: 0.1.0
Authors@R: c(
    person(
      "Keisuke", "Hanada",
      email = "keisuke.hanada.87@gmail.com",
      role = c("aut", "cre"),
      comment = c(ORCID = "0000-0002-1444-0280")
