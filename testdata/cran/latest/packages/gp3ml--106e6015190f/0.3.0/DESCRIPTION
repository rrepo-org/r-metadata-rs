Package: gp3ml
Type: Package
Title: Governance-First Predictive Modelling for 'Gazepoint' Research
Version: 0.3.0
Authors@R: person(
    given = "Stefanos",
    family = "Balaskas",
    email = "s.balaskas@ac.upatras.gr",
