Type: Package
Package: CopulaSCR
Title: Analysis of Semi-Competing Risks Data Using Copula-Based Models
Version: 1.0.2
Authors@R: c(
    person(given = "Tonghui",
    family = "Yu",
    role = c("aut", "cre"),
