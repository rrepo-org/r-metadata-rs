Package: testcorr
Type: Package
Title: Testing Zero Correlation
Version: 0.4.0
Authors@R: c(
    person("Violetta", "Dalla", email = "vidalla@econ.uoa.gr", role = c("aut", "cre")), 
    person("Liudas", "Giraitis", role = "aut"), 
    person("Peter C. B.", "Phillips", role = "aut")
