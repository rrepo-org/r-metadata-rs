Package: tarpolyglot
Type: Package
Title: Run Python, Julia, and Rust Inside 'targets' Pipeline Steps
Version: 0.2.0
Authors@R: c(
    person(
      given = "Pierre",
      family = "Solomon",
      email = "pierre.solomon@laposte.net",
      role = c("aut", "cre"),
      comment = c(ORCID = "0000-0001-7187-2664")
