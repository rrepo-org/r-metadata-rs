Package: extrafrail
Type: Package
Title: Estimation and Additional Tools for Alternative Shared Frailty
        Models
Version: 1.15
Date: 2026-08-15
Authors@R: c(person("Diego", "Gallardo", role = c("aut","cre"), email = "dgallardo@ubiobio.cl"),
