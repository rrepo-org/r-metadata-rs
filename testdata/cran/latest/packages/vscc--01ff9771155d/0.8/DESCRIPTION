Package: vscc
Type: Package
Title: Variable Selection for Clustering and Classification
Version: 0.8
Date: 2025-10-08
Authors@R: c(person("Jeffrey L.", "Andrews", role = c("aut")),
  person("Mackenzie R.", "Neal", role = c("aut", "cre"), email = "nealm6@mcmaster.ca"),
