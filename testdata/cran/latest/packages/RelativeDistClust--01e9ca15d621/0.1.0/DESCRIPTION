Package: RelativeDistClust
Type: Package
Title: Clustering with a Novel Non Euclidean Relative Distance
Version: 0.1.0
Authors@R: person(given = "Irene",
                    family = c("Creus", "Martí"),
                    role = c("aut", "cre"),
