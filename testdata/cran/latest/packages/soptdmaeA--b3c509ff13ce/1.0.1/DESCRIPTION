Package: soptdmaeA
Version: 1.0.1
Date: 2025-05-24
Title: Sequential Optimal Designs for Two-Colour cDNA Microarray
        Experiments
Authors@R: c(person("Dibaba Bayisa", "Gemechu", role = c("aut", "cre"), email = "diboobayu@gmail.com"),
             person("Legesse Kassa", "Debusho", role = "aut", email = "debuslk@unisa.ac.za"),
