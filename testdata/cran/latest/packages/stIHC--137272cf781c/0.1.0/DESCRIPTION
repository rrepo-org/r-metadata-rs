Package: stIHC
Type: Package
Title: Spatial Transcriptomics Iterative Hierarchical Clustering
Version: 0.1.0
Authors@R: 
    c(person("Catherine", "Higgins", , "catherine.higgins@ucd.ie", role = c("aut", "cre")),
