Package: K4Rumah
Type: Package
Title: Home Context Data Files for TIMSS 2023 Grade 4
Version: 0.1.0
Authors@R: c(person("Fadhlul", "Mubarak", role = c("aut", "cre"),
                     email = "mubarakfadhlul@gmail.com", comment = c(ORCID = "<0000-0001-7394-3817>")),
              person("Vinny", "Yuliani Sundara", role = c("aut"),
