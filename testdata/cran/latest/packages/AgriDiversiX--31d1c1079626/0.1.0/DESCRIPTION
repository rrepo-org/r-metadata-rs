Package: AgriDiversiX
Type: Package
Title: Agricultural Crop Diversification Indices Analysis
Version: 0.1.0
Authors@R: c(person("Santosha", "Rathod", role = c("aut", "cre"), email = "santoshagriculture@gmail.com"), person("Mrinmoy", "Ray", role = c("aut", "ctb")), person("Prabhat", "Kumar", role = c("aut", "ctb")), person("Rahul Patil", "Kumar", role = c("aut", "ctb")), person("Anil", "Kumar", role = c("aut", "ctb")))
