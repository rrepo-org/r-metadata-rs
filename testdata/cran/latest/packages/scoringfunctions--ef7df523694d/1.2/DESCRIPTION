Package: scoringfunctions
Version: 1.2
Date: 2026-08-30
Title: Loss Functions for Assessing Point Forecasts
Authors@R: c(
    person(given = "Hristos",
           family = "Tyralis",
           role = c("aut", "cre"),
           email = "montchrister@gmail.com",
