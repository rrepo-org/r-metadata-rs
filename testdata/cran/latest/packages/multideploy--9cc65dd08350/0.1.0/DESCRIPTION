Package: multideploy
Title: Deploy File Changes Across Multiple 'GitHub' Repositories
Version: 0.1.0
Authors@R: c(
    person("James Joseph", "Balamuta",
           email = "james.balamuta@gmail.com", 
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-2826-8458")
