Package: CRBHSF
Type: Package
Title: Cyber-Resilient Bayesian Healthcare Surveillance Framework
Version: 0.1.0
Authors@R: c(
    person("Muhammad", "Zahir Khan",
           email = "zahirstat007@gmail.com",
           role = c("aut", "cre")),
