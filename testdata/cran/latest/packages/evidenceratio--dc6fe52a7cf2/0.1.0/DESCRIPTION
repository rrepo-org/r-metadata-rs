Package: evidenceratio
Type: Package
Title: Likelihood-Based Evidence Ratios for Classical Statistical Tests
Version: 0.1.0
License: MIT + file LICENSE
Language: en-GB
Authors@R: 
    person(
        given = "Dylan",
        family = "Lawless",
