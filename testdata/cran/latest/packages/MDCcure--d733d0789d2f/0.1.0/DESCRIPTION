Package: MDCcure
Type: Package
Title: Martingale Dependence Tools and Testing for Mixture Cure Models
Version: 0.1.0
Authors@R: c(
    person("Blanca", "Monroy-Castillo", , "blancamonroy.96@gmail.com", role = c("aut", "cre")),
