Package: ordered
Title: 'parsnip' Engines and Wrappers for Ordinal Classification Models
Version: 0.1.0
Authors@R: c(
    person("Max", "Kuhn", , "max@posit.co",
           role = "aut",
           comment = c(ORCID = "0000-0003-2402-136X")),
    person("Jason Cory", "Brunson", , "cornelioid@gmail.com",
