Package: PhaseGMM
Type: Package
Title: Phase-Function Based Estimation and Inference for Linear
        Errors-in-Variables (EIV) Models
Version: 0.1.1
Authors@R: c(
    person(
      "Chang", "Liu",
      email = "leo12345liu@gmail.com",
      role = c("aut", "cre")
