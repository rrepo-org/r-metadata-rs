Package: betaregscale
Type: Package
Title: Beta Regression for Interval-Censored Scale-Derived Outcomes
Version: 2.7.4
Authors@R: c(person(given = "José Evandeilton",
                    family = "Lopes",
                    role = c("aut", "cre"),
                    email = "evandeilton@gmail.com",
                    comment = c(ORCID = "0009-0007-5887-4084")),
