Package: HSAUR2
Title: A Handbook of Statistical Analyses Using R (2nd Edition)
Date: 2025-05-02
Version: 1.1-21
Authors@R: c(person("Torsten", "Hothorn", role = c("aut", "cre"),
                 email = "Torsten.Hothorn@R-project.org", comment = c(ORCID = "0000-0001-8301-0471")),
