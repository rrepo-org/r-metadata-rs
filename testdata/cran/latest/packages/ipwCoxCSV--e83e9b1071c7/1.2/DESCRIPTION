Package: ipwCoxCSV
Type: Package
Title: Corrected Sandwich Inference for Inverse Probability Weighted
        Cox Models
Version: 1.2
Authors@R: c(person(given = "Di",
                        family = "Shu",
                        role = c("aut", "cre"),
                        email = "shudi1991@gmail.com"),
                 person(given = "Rui",
                        family = "Wang",
