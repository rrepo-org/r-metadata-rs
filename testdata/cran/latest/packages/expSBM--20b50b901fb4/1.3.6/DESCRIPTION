Package: expSBM
Type: Package
Title: An Exponential Stochastic Block Model for Interaction Lengths
Version: 1.3.6
Date: 2025-10-16
Authors@R: c(person("Riccardo", "Rastelli", role = c("aut", "cre"),
                    email = "riccardoras@gmail.com",
