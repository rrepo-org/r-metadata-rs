Package: rob
Title: Run Orders with Assignment-Expansion Method
Version: 0.1.0
Authors@R: 
    c(person("Romario", "Conto", email ="racontol@unal.edu.co", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-9944-137X")),
    person("Alexander", "Correa", email = "alcorrea@unal.edu.co", role = "ctb"),
