Package: deadwood
Type: Package
Title: Outlier Detection via Trimming of Mutual Reachability Minimum
        Spanning Trees
Version: 0.9.0-3
Date: 2026-02-20
Authors@R: 
    person("Marek", "Gagolewski",
        role = c("aut", "cre", "cph"),
        email = "marek@gagolewski.com",
        comment = c(ORCID = "0000-0003-0637-6028")
