Package: DBCVindex
Title: Calculates the Density-Based Clustering Validation (DBCV) Index
Version: 1.6
Authors@R: c(
                  person("Davide", "Chicco", email = "davidechicco@davidechicco.it", comment = c(ORCID = "0000-0001-9655-7142"),
