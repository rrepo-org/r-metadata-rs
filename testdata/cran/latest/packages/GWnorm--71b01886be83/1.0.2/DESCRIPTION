Package: GWnorm
Type: Package
Title: G-Wishart Normalising Constants for Gaussian Graphical Models
Version: 1.0.2
Date: 2026-07-07
Authors@R: c(person(given = "Ching",
                      family = "Wong",
                      role = c("aut")),
               person(given = "Jack",
                      family = "Kuipers",
                      role = c("aut", "cre"),
