Package: ebdm
Type: Package
Title: Estimating Bivariate Dependency from Marginal Data
Version: 3.0.1
Authors@R: 
    c(
      person(given = "Longwen", family = "Shang", role = c("aut"), email = "shanglongwen0918@gmail.com"),
