Package: geopsych
Type: Package
Title: Methods of Applied Psychology and Psychometrics in Geographical
        Analysis
Version: 0.1.0
Authors@R: c(
    person(
      "Sui", "Zhang",
      email = "sui.zhang@manchester.ac.uk",
      role = c("aut", "cre"),
      comment = c(ORCID = "0000-0002-4143-2331")
    )
