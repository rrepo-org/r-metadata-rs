Package: margEVT
Type: Package
Title: Regularized Point Processes and Stochastic Marginalization for
        Extremes
Version: 0.2.0
Authors@R: c(
    person("Rodrigo Fonseca", "Villa", email = "rodrigo03.villa@gmail.com",
