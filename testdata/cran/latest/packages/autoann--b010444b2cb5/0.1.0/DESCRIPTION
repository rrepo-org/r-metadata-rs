Package: autoann
Title: Neural Network–Based Model Selection and Forecasting
Type: Package
Version: 0.1.0
Authors@R: c(person("Dr. Pramit", "Pandit", role = c("aut","cre"), email = "pramitpandit@gmail.com"),
             person("Ms. Moumita", "Paul", role = "aut"),
