Package: PlotNormTest
Title: Graphical Univariate/Multivariate Assessments for Normality
        Assumption
Version: 1.0.1
Authors@R: c(person("Huong", "Tran", email =  "quynhhuong5335@gmail.com", role = c("aut", "cre"),
