Package: flex
Title: Fuzzy Linear Squares Estimation with Explicit Formula (FLEX)
Version: 0.1.0
Date: 2025-08-27
Authors@R: c(
    person(given = "Chaewon", family = "Lee",
           role = c("aut", "cre"),
           email = "chaewon.lee@unc.edu"),
    person(given = c("Jin", "Hee"),
           family = "Yoon",
           role = "ctb")
