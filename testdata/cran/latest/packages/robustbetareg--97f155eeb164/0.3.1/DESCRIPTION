Package: robustbetareg
Title: Robust Beta Regression
Authors@R: c(
  person("Felipe", "Queiroz", email = "ffelipeq@outlook.com", role = c("aut", "cre")),
  person("Yuri", "Maluf", email = "yurimaluf@gmail.com", role = c("aut")),
