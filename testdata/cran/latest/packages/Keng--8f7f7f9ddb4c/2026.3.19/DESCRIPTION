Package: Keng
Title: Knock Errors Off Nice Guesses
Version: 2026.3.19
Authors@R: 
    person(
    given = "Qingyao",
    family = "Zhang",
    email = "qingyaozhang@outlook.com", 
    role = c("aut", "cre"),
