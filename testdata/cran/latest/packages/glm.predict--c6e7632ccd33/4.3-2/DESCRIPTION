Package: glm.predict
Type: Package
Title: Predicted Values and Discrete Changes for Regression Models
Version: 4.3-2
Date: 2025-11-07
Authors@R: person(given = c("Benjamin", "E."),
                  family = "Schlegel",
                  role = c("aut", "cre"),
                  email = "kontakt@benjaminschlegel.ch",
				  comment = c(ORCID = "0000-0002-5789-8996")
