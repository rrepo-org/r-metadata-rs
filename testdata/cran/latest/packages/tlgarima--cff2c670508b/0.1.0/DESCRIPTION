Package: tlgarima
Type: Package
Title: The Topp–Leone Garima Distribution
Version: 0.1.0
Authors@R: c( person( "Arin", "Boonmeekham",email = "arin.boo@ku.th", role = "aut"),
    person( "Thidaporn", "Supapakorn",email = "fscitdps@ku.ac.th", role = "aut"),
