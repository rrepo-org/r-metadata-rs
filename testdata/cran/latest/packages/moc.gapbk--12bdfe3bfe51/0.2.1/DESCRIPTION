Package: moc.gapbk
Type: Package
Title: Multi-Objective Clustering Algorithm Guided by a-Priori
        Biological Knowledge
Version: 0.2.1
Authors@R: c(
    person("Jorge", "Parraga-Alava",
           email = "jorge.parraga@utm.edu.ec",
           role = c("aut", "cre", "cph"),
