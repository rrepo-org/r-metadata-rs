Package: selecta
Type: Package
Title: Declarative EQUATOR-Style Flow Diagrams for Clinical Studies
Version: 0.6.1
Authors@R: c(
    person(
        given = c("Paul", "Hsin-ti"), 
        family = "McClelland", 
