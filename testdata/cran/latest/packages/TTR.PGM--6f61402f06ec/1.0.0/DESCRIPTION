Package: TTR.PGM
Type: Package
Title: Thornley Transport Resistance Plant Growth Model
Version: 1.0.0
Authors@R: c(person(given = "Steven",
                      family = "Higgins",
                      role = c("aut", "cre", "cph"),
                      email = "steven.higgins@uni-bayreuth.de"),
               person(given = "Arne",
                      family = "Burkhardt",
