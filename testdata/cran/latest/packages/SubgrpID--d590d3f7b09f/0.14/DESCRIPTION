Package: SubgrpID
Type: Package
Title: Patient Subgroup Identification for Clinical Drug Development
Version: 0.14
Date: 2026-03-08
URL: https://xhuang4.github.io/seqbatting-html/
Authors@R: c(person("Xin", "Huang", role = c("aut", "cre","cph"), email = "xin.huang@abbvie.com"),
