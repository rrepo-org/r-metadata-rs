Package: simFastBOIN
Type: Package
Title: Fast Bayesian Optimal Interval Design for Phase I Dose-Finding
        Trials
Version: 1.3.2
Date: 2025-12-06
Authors@R: person(given = "Gosuke",
                  family = "Homma",
