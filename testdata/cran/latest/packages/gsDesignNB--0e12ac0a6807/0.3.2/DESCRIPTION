Package: gsDesignNB
Version: 0.3.2
Title: Sample Size and Simulation for Negative Binomial Outcomes
Authors@R: c(
    person("Keaven", "Anderson", email = "keaven_anderson@merck.com", role = c("aut", "cre")),
    person("Hongtao", "Zhang", role = "aut"),
    person("Andrea", "Maes", role = "aut"),
