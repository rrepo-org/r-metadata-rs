Package: mvboxcox
Title: Bivariate Logistic Box-Cox Regression
Version: 0.1.4
Authors@R: 
    c(
      person(given = "Shiyu", family = "Xu",
             email = "xushiyu98@outlook.com", role = "aut"),
      person(given = "Xuekui", family = "Zhang",
             email = "ubcxzhang@gmail.com", role = c("aut", "cre"))
