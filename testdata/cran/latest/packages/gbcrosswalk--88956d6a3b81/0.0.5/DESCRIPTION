Package: gbcrosswalk
Title: Crosswalk Chinese GB Industry Classifications Across Years
Version: 0.0.5
Authors@R: c(
    person(
      "Yajie", "Wang",
      role = c("aut", "cre"),
      email = "wangyajie621@gmail.com",
      comment = c(
        affiliation = paste(
