Package: HHBayes
Title: Bayesian Household Transmission Modeling with 'Stan'
Version: 0.1.1
Authors@R: c(
  person(given = "Ke", family = "Li",
         email = "ke.li.kl662@yale.edu",
         role = c("aut","cre"),
