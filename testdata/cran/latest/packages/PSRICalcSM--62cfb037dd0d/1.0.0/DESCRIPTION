Package: PSRICalcSM
Type: Package
Title: Plant Stress Response Index Calculator - Softmax Method
Version: 1.0.0
Authors@R: c(
    person("Richard", "Feiss", 
           email = "feiss026@umn.edu", 
           role = c("aut", "cre"),
           comment = c(ORCID = "0009-0008-0409-6042")),
    person("University of Minnesota", 
