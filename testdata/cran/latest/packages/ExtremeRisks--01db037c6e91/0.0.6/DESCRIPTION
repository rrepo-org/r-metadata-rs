Package: ExtremeRisks
Version: 0.0.6
Date: 2026-05-08
Title: Extreme Risk Measures
Authors@R: c(person("Simone","Padoan", role = c("cre", "aut"), email="simone.padoan@unibocconi.it"),
	    person("Gilles", "Stupfler", role = "aut", email="gilles.stupfler@univ-angers.fr"),
