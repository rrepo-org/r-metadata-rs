Package: GCubeR
Title: Estimation of Forest Volume, Biomass, and Carbon
Version: 0.1.3
Authors@R: c(
    person("Juliette", "Defontaine", role = c("aut")),
    person("David", "Linchant", email ="david.linchant@gmail.com", role = c("aut", "cre")),
    person("Samuel", "Douin", role = c("aut")),
