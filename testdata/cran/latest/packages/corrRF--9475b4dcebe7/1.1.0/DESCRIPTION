Package: corrRF
Type: Package
Title: Clustered Random Forests for Optimal Prediction and Inference of
        Clustered Data
Version: 1.1.0
Authors@R: person(given = c("Elliot", "H."), family = "Young", role = c("aut", "cre"), email = "ey244@cam.ac.uk")
