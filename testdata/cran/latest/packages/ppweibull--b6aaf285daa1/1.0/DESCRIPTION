Package: ppweibull
Type: Package
Title: Piecewise Lifetime Models
Version: 1.0
Date: 2026-02-02
Authors@R: c(person("Diego", "Gallardo", role = c("aut","cre"), email = "dgallardo@ubiobio.cl"),
	person("Yolanda","Gomez", role=c("aut"), email="ygomez@ubiobio.cl"),
	person("Hector","Gomez", role=c("aut"), email="hgomez@uantof.cl"),
