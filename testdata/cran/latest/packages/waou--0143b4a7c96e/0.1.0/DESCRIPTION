Package: waou
Title: Weighting All of Us
Version: 0.1.0
Authors@R: c(
    person("Daniel", "Brannock", , "mbrannock@rti.org", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-8095-547X")),
