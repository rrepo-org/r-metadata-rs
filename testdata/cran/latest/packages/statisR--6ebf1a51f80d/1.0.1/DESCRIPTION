Package: statisR
Type: Package
Title: STATIS and STATIS DUAL Multivariate Methods
Version: 1.0.1
Authors@R: c(
  person(given = "Oldemar", family = "Rodriguez", role = c("aut", "cre"), email = "oldemar.rodriguez@ucr.ac.cr"),
