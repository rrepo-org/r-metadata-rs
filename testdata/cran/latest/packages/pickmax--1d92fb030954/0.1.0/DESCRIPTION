Package: pickmax
Type: Package
Title: Split and Coalesce Duplicated Records
Version: 0.1.0
Authors@R: c(person("Sbonelo", "Chamane", email = "SChamane@hsrc.ac.za", role = c("aut", "cre"), comment = "ORCID: 0000-0001-5350-5203"),
