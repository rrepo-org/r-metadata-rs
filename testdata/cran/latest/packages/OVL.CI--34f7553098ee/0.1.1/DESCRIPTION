Package: OVL.CI
Type: Package
Title: Inference on the Overlap Coefficient
Version: 0.1.1
Authors@R: c(
  person("Alba M. Franco-Pereira", role = c("aut", "cre","cph"), email = "albfranc@ucm.es"),
