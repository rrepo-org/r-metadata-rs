Package: NAVAECI
Type: Package
Title: Non-Asymptotically Valid and Asymptotically Exact (NAVAE)
        Confidence Intervals
Version: 0.1.1
Authors@R: c(
  person("Alexis", "Derumigny",, email = "a.f.f.derumigny@tudelft.nl", role = c("aut", "cre"),
