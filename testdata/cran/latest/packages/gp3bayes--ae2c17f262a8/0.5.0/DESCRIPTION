Package: gp3bayes
Title: Contract-First Bayesian Workflows for Hierarchical Behavioural
        Data
Version: 0.5.0
Authors@R: 
    person(
      given = "Stefanos",
      family = "Balaskas",
      email = "s.balaskas@ac.upatras.gr",
      role = c("aut", "cre", "cph"),
