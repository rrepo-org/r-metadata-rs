Package: phytoclass
Title: Estimate Chla Concentrations of Phytoplankton Groups
Version: 2.3.1
Authors@R: c(person(
    "Alexander", "Hayward", role = c("aut", "cre", "cph"), email = "phytoclass@outlook.com"
  ), person(
    given="Tylar", family="Murray", role = c("aut")
