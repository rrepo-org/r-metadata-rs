Package: FactChar
Type: Package
Title: Characterization and Diagnostic Tools for Factorial Block
        Designs
Version: 1.0
Authors@R: c(
    person("Sukanta", "Dash", email = "sukanta.iasri@gmail.com", role = c("aut", "cre")),
