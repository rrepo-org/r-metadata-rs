Title: Tool for Construction of Two-Phase Experimental Designs
Version: 1.0.0
Authors@R: c(person(given = "Akhilesh", family = "Jha", email = "jha.akhilesh09@gmail.com", role = c("aut", "cre")), person(given = "Cini", family = "Varghese", email = "cini2204@gmail.com", role = "aut"), person(given = "Seema", family = "Jaggi", email = "seema.jaggi@icar.gov.in", role = "aut"), person(given = "Eldho", family = "Varghese", email = "eldoiasri@gmail.com", role = "aut"), person(given = "Mohd", family = "Harun", email = "mohd.harun@icar.gov.in", role = "aut"))
