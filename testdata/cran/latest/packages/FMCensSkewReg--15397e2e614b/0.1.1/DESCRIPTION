Package: FMCensSkewReg
Title: Finite Mixture of Censored Regression Models with Skewed
        Distributions
Version: 0.1.1
Authors@R: c(
    person("Jiwon", "Park", email = "pcjylove87@gmail.com", role = c("aut", "cre")),
