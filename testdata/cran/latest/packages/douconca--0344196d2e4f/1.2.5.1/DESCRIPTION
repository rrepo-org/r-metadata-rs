Package: douconca
Type: Package
Title: Double Constrained Correspondence Analysis for Trait-Environment
        Analysis in Ecology
Version: 1.2.5.1
Date: 2026-08-24
Authors@R: c(person(given = "Cajo J.F", 
                    family = "ter Braak", 
                    email = "cajo.terbraak@wur.nl",
                    role = "aut", 
                    comment = c(ORCID = "0000-0002-0414-8745")),
            person(given = "Bart-Jan", 
