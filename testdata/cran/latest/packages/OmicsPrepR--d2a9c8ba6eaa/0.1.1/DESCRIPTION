Package: OmicsPrepR
Title: Unified Preprocessing Toolkit for Proteomics and Metabolomics
Version: 0.1.1
Authors@R: 
    c(
      person("Isaac", "Osei", email = "ikemillar65@gmail.com", role = c("aut", "cre")),
