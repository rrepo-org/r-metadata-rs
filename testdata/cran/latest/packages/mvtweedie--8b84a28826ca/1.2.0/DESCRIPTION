Package: mvtweedie
Type: Package
Title: Estimate Diet Proportions Using Multivariate Tweedie Model
Version: 1.2.0
Date: 2025-12-19
Authors@R: 
    c(person(given = "James",
             family = "Thorson",
             role = c("aut", "cre"),
             email = "James.Thorson@noaa.gov",
             comment = c(ORCID = "0000-0001-7415-1010"))
