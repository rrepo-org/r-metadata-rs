Package: PMLE4SCR
Type: Package
Title: Pseudo Maximum Likelihood Estimation for Semi-Competing Risks
        Data
Version: 0.1.0
Authors@R: c(
    person("Qian M.", "Zhou",
            email = "qz70@msstate.edu",
