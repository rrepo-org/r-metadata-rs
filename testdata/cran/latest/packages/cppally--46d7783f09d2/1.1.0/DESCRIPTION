Package: cppally
Title: A 'C++20' API for R
Version: 1.1.0
Authors@R: c(
    person("Nick", "Christofides", , "nick.christofides.r@gmail.com", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-9743-7342")),
    person("Martin Leitner-Ankerl", role = "cph",
