Package: StochFracPoisson
Title: Stochastic Poisson Processes and Fractional Counting Models
Version: 0.1.0
Authors@R: 
    c(person(given = "Shikhar",
             family = "Tyagi",
             role = c("aut", "cre"),
             email = "shikhar1093tyagi@gmail.com",
             comment = c(ORCID = "0000-0003-1606-0844")),
