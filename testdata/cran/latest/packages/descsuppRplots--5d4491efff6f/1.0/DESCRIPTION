Package: descsuppRplots
Title: Generate Plots for All Variables in Descriptive Tables
Version: 1.0
Authors@R: 
    c(person(given = "Andreas",
             family = "Leha",
             role = c("aut"),
             email = "andreas.leha@med.uni-goettingen.de"),
      person(given = "Fabian",
