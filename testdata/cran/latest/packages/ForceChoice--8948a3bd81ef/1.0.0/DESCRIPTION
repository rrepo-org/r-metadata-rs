Package: ForceChoice
Title: Forced-Choice Modeling Based on Item Response Theory and
        Cognitive Diagnostic Models
Version: 1.0.0
Authors@R: c(person(given = "Haijiang", 
                    family = "Qin", 
                    role = c("aut", "cre", "cph"), 
                    email = "haijiang133@outlook.com", 
                    comment = c(ORCID = "0009-0000-6721-5653")),
             person(given = "Lei",
