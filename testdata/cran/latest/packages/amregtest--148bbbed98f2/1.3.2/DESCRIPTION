Package: amregtest
Title: Runs Allelematch Regression Tests
Version: 1.3.2
Date: 2026-08-04
Authors@R: c(
    person("Department of Wildlife, Fish and Environmental Studies at Swedish University of Agricultural Sciences",
           role = "cph"),
