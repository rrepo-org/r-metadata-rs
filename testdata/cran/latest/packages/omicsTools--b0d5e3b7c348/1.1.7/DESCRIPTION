Package: omicsTools
Title: Omics Data Process Toolbox
Version: 1.1.7
Date: 2025-12-16
Authors@R: c(
    person("Yaoxiang", "Li", , "liyaoxiang@outlook.com", role = c("cre", "aut"),
           comment = c(ORCID = "0000-0001-9200-1016"))
