Package: mcanalysis
Title: Markov Chain Analysis for Structural Behaviour and Stability
Type: Package
Version: 0.1.0
Authors@R: c(person("Dr. Pramit", "Pandit", role = c("aut","cre"), email = "pramitpandit@gmail.com"),
