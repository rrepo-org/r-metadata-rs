Package: OSIRCR
Type: Package
Title: Cosine Regression-Based Online Sliced Inverse Regression
        Algorithm
Version: 0.2.9
Authors@R: c(
     person(given = "Guangbao", family = "Guo", role = c("aut", "cre"), email = "ggb11111111@163.com"),
