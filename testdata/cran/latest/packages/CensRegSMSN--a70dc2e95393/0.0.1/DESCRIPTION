Package: CensRegSMSN
Title: Censored Linear Regression Models under Heavy‑tailed
        Distributions
Version: 0.0.1
Authors@R: 
    c(
        person(given = "Yessenia",  family = "Alvarez Gil", email = "yessenia.alvarez@ufpe.br", role = c("aut", "cre")),
