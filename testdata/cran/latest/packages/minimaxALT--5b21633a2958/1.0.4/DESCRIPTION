Package: minimaxALT
Type: Package
Title: Generate Optimal Designs of Accelerated Life Test using
        PSO-Based Algorithm
Version: 1.0.4
Encoding: UTF-8
License: GPL (>= 3)
Authors@R: c(
  person("Hoai-Linh", "Hoang", email = "hoailinh.hoang17@gmail.com", role = c("aut", "cre")),
