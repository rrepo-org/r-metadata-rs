Package: parTimeROC
Title: Parametric Time-Dependent Receiver Operating Characteristic
Version: 0.2.0
Authors@R: 
    c(person("Faiz", "Azhar", , "faiz.azhar241@gmail.com", role = c("aut", "cre", "cph"),
