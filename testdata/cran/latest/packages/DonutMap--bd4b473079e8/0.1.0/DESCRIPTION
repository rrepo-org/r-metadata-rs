Package: DonutMap
Title: Donut Maps with 'sf', 'ggplot2', and 'leaflet'
Version: 0.1.0
Authors@R: 
    person(
        given = "Aurélien",
        family = "Nicosia",
        email = "aurelien.nicosia@mat.ulaval.ca",
        role = c("aut", "cre")
