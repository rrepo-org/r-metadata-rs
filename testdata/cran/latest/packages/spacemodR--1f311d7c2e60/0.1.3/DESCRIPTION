Package: spacemodR
Title: Workflow for Environmental Risk Assessment: Habitat, Food Web,
        Dispersal, Exposure and Risk
Version: 0.1.3
Authors@R: 
    c(person("Virgile", "Baudrot", email = "virgile.baudrot@qonfluens.com", role = c("aut", "cre")),
