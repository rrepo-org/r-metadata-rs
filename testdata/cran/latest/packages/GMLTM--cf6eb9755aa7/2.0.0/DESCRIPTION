Package: GMLTM
Type: Package
Title: Generalized Multicomponent Latent Trait Model for Diagnosis
Version: 2.0.0
Authors@R: c(
    person("Eduar", "Ramirez", email = "edrami02@ucm.es", role = c("aut", "cre")),
    person("Marcos", "Jimenez", email = "marcosjnezhquez@gmail.com", role = "aut"),
