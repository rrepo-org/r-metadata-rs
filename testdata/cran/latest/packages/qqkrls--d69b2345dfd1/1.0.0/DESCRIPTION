Package: qqkrls
Type: Package
Title: Quantile-on-Quantile Kernel Regularized Least Squares
Version: 1.0.0
Authors@R: c(
    person("Merwan", "Roudane",
           email = "merwanroudane920@gmail.com",
           role = c("aut", "cre", "cph")),
    person("Tomiwa Sunday", "Adebayo", role = "ctb",
