Package: multigroup.vaccine
Type: Package
Title: Analyze Outbreak Models of Multi-Group Populations with
        Vaccination
Version: 0.1.1
Authors@R: 
    c(person("Damon", "Toth", , "damon.toth@hsc.utah.edu", role = c("aut", "cre", "cph"),
