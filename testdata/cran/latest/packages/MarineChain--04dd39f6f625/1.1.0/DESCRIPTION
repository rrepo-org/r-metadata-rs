Package: MarineChain
Type: Package
Title: Blockchain-Enabled Maritime Transportation System Simulator
Version: 1.1.0
Authors@R: c(
    person("Isaac", "Osei", email = "ikemillar65@gmail.com", role = c("aut", "cre")),
    person("Yamini", "Alakunta", email = "yamini_alakunta@srmap.edu.in", role = "aut")
