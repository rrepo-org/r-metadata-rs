Package: LitFetchR
Type: Package
Title: Automatically Fetching References Metadata from Literature
        Databases
Version: 1.0.0
Authors@R: c(
            person("Thomas", "Dumond", role = c("cre","aut","cph"), email = "thomas.dumond@adelaide.edu.au", comment = c(ORCID = "0000-0002-9427-8649")),
