Package: MYIS
Type: Package
Title: 'Moreau-Yosida' Importance Sampling for Statistical Inference
Version: 0.1.0
Authors@R: c(
    person("Shikhar", "Tyagi", email = "shikhar1093tyagi@gmail.com",
           role = c("aut", "cre"),
