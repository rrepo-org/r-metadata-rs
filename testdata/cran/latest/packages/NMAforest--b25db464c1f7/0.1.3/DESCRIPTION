Package: NMAforest
Type: Package
Title: Forest Plots for Network Meta-Analysis with Proportion for Paths
        and Studies
Version: 0.1.3
Authors@R: c(person("Yanqi", "Zhang", email = "zyq1998@iastate.edu", role = c("aut", "cre")),
