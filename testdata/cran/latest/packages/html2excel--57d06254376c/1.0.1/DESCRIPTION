Package: html2excel
Type: Package
Title: Convert 'HTML' Tables to 'Excel' Files
Version: 1.0.1
Date: 2026-07-12
Authors@R: c(
    person(
      "Paul", "Northrop",
      email = "p.northrop@ucl.ac.uk",
      role = c("aut", "cre", "cph")
    )
