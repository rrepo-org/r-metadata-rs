Package: MBRM
Type: Package
Title: Mixed Regression Models with Generalized Log-Gamma Random
        Effects
Version: 0.1.1
Authors@R: c(person("Lizandra C.", "Fabio", email = "lizandra.fabio@ufba.br", role = "aut"),
  person("Vanessa", "Barros", email = "vbarrosoliveira@gmail.com", role = "aut"),
