Package: BayesPocket
Type: Package
Title: Bayesian Causal Inference for Periodontal Diseases in
        Longitudinal Studies
Version: 0.1.0
Authors@R: c(
    person("Qingyang", "Liu", email = "rh8liuqy@gmail.com", role = c("aut", "cre"), comment = c(ORCID = "0000-0003-3265-6330")),
