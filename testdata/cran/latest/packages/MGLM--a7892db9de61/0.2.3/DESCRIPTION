Title: Multivariate Response Generalized Linear Models
Authors@R: c(
    person("Yiwen", "Zhang", email = "zhangyiwen1015@gmail.com", role = c("aut")),
    person("Hua", "Zhou", email = "huazhou@ucla.edu", role = c("aut")),
