Package: bmem
Type: Package
Title: Mediation Analysis with Missing Data Using Bootstrap
Version: 2.2
Date: 2025-09-02
Authors@R: c(person(given = "Zhiyong",
                      family = "Zhang",
                      role = c("aut", "cre"),
                      email = "zhiyongzhang@nd.edu"),
               person(given = "Lijuan",
