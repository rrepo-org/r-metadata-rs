Package: LRQVB
Title: Low Rank Correction Quantile Variational Bayesian Algorithm for
        Multi-Source Heterogeneous Models
Version: 1.0.0
Authors@R: 
    c(person(given = "Lu",
             family = "Luo", 
             email = "luolu@stu.ynu.edu.cn",
             role = c("aut", "cre")),
      person(given = "Huiqiong",
