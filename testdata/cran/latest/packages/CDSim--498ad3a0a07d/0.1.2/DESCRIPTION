Package: CDSim
Type: Package
Title: Simulating Climate Data for Research and Modelling
Version: 0.1.2
Date: 2026-04-19
Authors@R: 
    c(
    person("Isaac", "Osei", role = c("aut", "cre"), email = "ikemillar65@gmail.com"),
    person("Acheampong", "Baafi-Adomako", role = "aut", email = "acheampongbaafi1@gmail.com")
