Title: Partial Least Squares Regression Models with Big Matrices
Authors@R: c(
  person(given = "Frederic", family= "Bertrand", role = c("cre", "aut"), 
  email = "frederic.bertrand@lecnam.net", comment = c(ORCID = "0000-0002-0837-8281")),
