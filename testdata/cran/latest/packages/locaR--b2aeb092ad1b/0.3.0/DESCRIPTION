Package: locaR
Type: Package
Title: A Set of Tools for Sound Localization
Version: 0.3.0
Authors@R: c(
    person("Richard", "Hedley", email = "rwhedley@gmail.com", role = c("cre", "aut"), comment = c(ORCID = "0000-0001-9588-5515")),
